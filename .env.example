# Cortex — local development environment.
# Copy to `.env` and edit. `.env` is gitignored.

# ---------- Cortex ----------
CORTEX_LOG_LEVEL=info
CORTEX_API_PORT=17000
CORTEX_BIND=127.0.0.1

# ---------- Host port overrides (set any to remap) ----------
VECTORIZER_HOST_PORT=17001
NEXUS_HOST_PORT=17002
SYNAP_HOST_PORT=17003
MEILI_HOST_PORT=17004

# ---------- Backend URLs (used by cortex-api / workers) ----------
VECTORIZER_URL=http://127.0.0.1:17001
NEXUS_URL=http://127.0.0.1:17002
SYNAP_URL=http://127.0.0.1:17003
MEILI_URL=http://127.0.0.1:17004
MEILI_MASTER_KEY=cortex-dev-master-key

# ---------- Classifier (spec 05) ----------
CORTEX_CLASSIFIER_MODE=cli              # cli | static | disabled (aliases: off, none)
CORTEX_CLASSIFIER_MODEL=claude-haiku-4-5
CLAUDE_CODE_BIN=claude                  # CLI path; required when mode=cli
ANTHROPIC_API_KEY=                      # required only when mode=sdk

# ---------- Embedder (spec 06) ----------
CORTEX_EMBED_MODEL=nomic-embed-text-v1.5
CORTEX_EMBED_BATCH=64

# ---------- Budgets ----------
CORTEX_CLASSIFIER_USD_PER_DAY=20

# ---------- Retention ----------
CORTEX_RETENTION_PII_HIGH_DAYS=30
CORTEX_RETENTION_PII_MED_DAYS=365
CORTEX_RETENTION_FP32_TO_PQ_DAYS=30
CORTEX_RETENTION_PQ_TO_BIN_DAYS=365

# --- cortex-embedder ---
CORTEX_EMBEDDER_WORKERS=6
CORTEX_EMBEDDER_CHUNKER_CONCURRENCY=4
CORTEX_EMBEDDER_UPSERT_BATCH=64
CORTEX_EMBEDDER_MAX_RETRY=3
CORTEX_EMBEDDER_VECTORIZER_URL=http://127.0.0.1:17001
CORTEX_EMBEDDER_SYNAP_URL=http://127.0.0.1:17003
CORTEX_EMBEDDER_SYNAP_GROUP=cortex-embedder
CORTEX_EMBEDDER_VECTORIZER_USER=admin
CORTEX_EMBEDDER_VECTORIZER_PASSWORD=cortex-dev-admin
CORTEX_EMBEDDER_COLLECTION_PREFIX=cortex
# Vectorizer 3.0's default embedder ships 512-dim vectors. Keep this
# aligned with /embed dim or every insert_texts batch fails with
# "Invalid dimension".
CORTEX_EMBEDDER_DIM=512
# Set to 1 to run integration tests against the live stack.
CORTEX_EMBEDDER_IT=0

# ---------- Fulltext worker (Meilisearch) ----------
CORTEX_FULLTEXT_MEILI_URL=http://127.0.0.1:17004
CORTEX_FULLTEXT_MEILI_API_KEY=cortex-dev-master-key
CORTEX_FULLTEXT_SYNAP_URL=http://127.0.0.1:17003
