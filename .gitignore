# Rulebook - ignore runtime data, keep specs and tasks
/.rulebook/*
!/.rulebook/specs/
!/.rulebook/tasks/
!/.rulebook/tasks/**/*.md
!/.rulebook/rulebook.json

# Patterns added by @hivellm/rulebook
# Added at: 2026-04-17T23:10:27.856Z

*.log
*.swo
*.swp
*~
.DS_Store
.cache/
.env
.env.*.local
.env.local
.idea/
.vscode/
Thumbs.db
logs/
temp/
tmp/

CLAUDE.local.md
.rulebook/backup/
.rulebook/handoff/_pending.md
.rulebook/handoff/.urgent
.playwright-mcp

# Rust
target
/target/
**/target/
*.rs.bk
.cargo/

# Cortex runtime state files (per-process resume points)
.cortex-*.state.json

# Claude Code session lock (per-process)
.claude/scheduled_tasks.lock

.rulebook/telemetry/

# Operator workarounds + diagnostic dumps under /scripts.
# Temporary files per AGENTS.md must not enter git history.
scripts/backup/
scripts/graph/*.errors.txt
scripts/graph/*.stats.txt
scripts/probes/probe_*.py
scripts/graph/cypher_load.py
scripts/graph/graph_correlate.py

# Python bytecode cache (generated by helper scripts under /scripts).
__pycache__/
*.pyc

# Cypher dumps — generated graph exports often embed transcript text
# and have leaked credentials in the past (see SECURITY note in
# scripts/graph/graph_correlate.py). Block globally; whitelist the
# hand-written query templates under cortex-workers/cypher/.
*.cypher
!crates/cortex-workers/cypher/*.cypher

# SQLite databases + backups
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite.bak
*.sqlite.bak.*
