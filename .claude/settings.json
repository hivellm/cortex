{
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Agent(*)",
      "TodoWrite(*)",
      "WebFetch(*)",
      "WebSearch(*)",
      "Skill(*)",
      "PowerShell(*)",
      "ToolSearch(*)",
      "mcp__tml__*",
      "mcp__rulebook__*",
      "mcp__cortex__*",
      "mcp__plugin_playwright_playwright__*",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git blame:*)",
      "Bash(npm run type-check:*)",
      "Bash(npm test:*)",
      "mcp__rulebook"
    ],
    "defaultMode": "acceptEdits"
  },
  "autoMode": {
    "environment": [
      "$defaults",
      "Organization: solo maintainer's personal project (HiveLLM ecosystem, e:/HiveLLM/*)",
      "Repository visibility: private, local-only"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/.claude/hooks/enforce-pre-tool.sh"
          }
        ]
      }
    ]
  },
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "statusLine": {
    "type": "command",
    "command": "echo \"$(basename \"$(pwd)\")$(git branch --show-current 2>/dev/null | sed \"s/^/ | /\")\""
  },
  "model": "sonnet"
}
