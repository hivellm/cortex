#!/usr/bin/env bash
# Bring the Cortex local stack up.
set -euo pipefail

cd "$(dirname "$0")/.."

if [ ! -f .env ]; then
    cp .env.example .env
    echo "note: created .env from .env.example — edit secrets before using in anger."
fi

echo "[1/3] docker compose up -d"
docker compose up -d --wait

echo "[2/3] waiting for health..."
docker compose ps

echo "[3/3] running first-time init (idempotent)"
bin/cortex-init.sh

echo
echo "cortex local stack is up."
echo "  vectorizer  → \${VECTORIZER_URL:-http://127.0.0.1:15001}"
echo "  nexus       → \${NEXUS_URL:-http://127.0.0.1:15002}"
echo "  synap       → \${SYNAP_URL:-http://127.0.0.1:15003}"
echo "  meilisearch → \${MEILI_URL:-http://127.0.0.1:15004}"
