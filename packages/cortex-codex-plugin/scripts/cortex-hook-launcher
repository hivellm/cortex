#!/bin/sh
# Local Cortex lifecycle transport. Missing or failed binaries fail open.
event="${1:-}"
case "$event" in
    SessionStart|UserPromptSubmit|PostToolUse|Stop|SubagentStop) ;;
    *) cat >/dev/null; printf '{}\n'; exit 0 ;;
esac
bin=""
if command -v cortex >/dev/null 2>&1; then
    bin=$(command -v cortex)
else
    for candidate in "${CORTEX_HOME:-}/bin/cortex" "${CORTEX_HOME:-}/bin/cortex.exe" \
        "${USERPROFILE:-${HOME:-}}/.cortex/bin/cortex" "${USERPROFILE:-${HOME:-}}/.cortex/bin/cortex.exe"; do
        case "$candidate" in /bin/*) continue ;; esac
        if [ -f "$candidate" ]; then bin="$candidate"; break; fi
    done
fi
if [ -z "$bin" ]; then cat >/dev/null; printf '{}\n'; exit 0; fi
if reply=$("$bin" hook --client codex --event "$event" 2>/dev/null) && [ -n "$reply" ]; then
    printf '%s\n' "$reply"
else
    printf '{}\n'
fi
exit 0
