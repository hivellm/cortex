{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT}/scripts/cortex-hook-launcher\" SessionStart",
            "commandWindows": "cmd.exe /d /c call \"${PLUGIN_ROOT}\\scripts\\cortex-hook-launcher.cmd\" SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
