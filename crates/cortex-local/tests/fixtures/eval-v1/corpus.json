{
  "schema_version": 1,
  "license": "CC0-1.0",
  "memories": [
    {
      "key": "atlas-storage",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "accepted",
      "title": "Embedded storage for desktop notes",
      "body": "Use SQLite for offline desktop notes. A single local file keeps deployment small and lets searches work without a server.",
      "source_id": "fiction:atlas-storage",
      "supersedes_key": "atlas-storage-old"
    },
    {
      "key": "atlas-storage-old",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "superseded",
      "title": "Retired server storage choice",
      "body": "Use PostgreSQL for desktop notes. This earlier decision was replaced because field laptops must work offline.",
      "source_id": "fiction:atlas-storage-old"
    },
    {
      "key": "atlas-sync-proposal",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "proposed",
      "title": "Proposed cloud synchronization",
      "body": "Consider uploading desktop notes to a hosted PostgreSQL service for team synchronization. This proposal has not been accepted.",
      "source_id": "fiction:atlas-sync-proposal"
    },
    {
      "key": "atlas-timeout-old",
      "repository": "Atlas",
      "kind": "lesson",
      "authority": "superseded",
      "title": "Retired blanket timeout increase",
      "body": "Increase every request timeout to five seconds when database tests fail. This diagnosis ignored connection cleanup.",
      "source_id": "fiction:atlas-timeout-old"
    },
    {
      "key": "atlas-timeout-fix",
      "repository": "Atlas",
      "kind": "lesson",
      "authority": "accepted",
      "title": "Database timeout correction",
      "body": "Slow connection cleanup can consume the request deadline after a successful query. Measure cleanup separately and keep production deadlines unchanged; control time only in semantic tests.",
      "source_id": "fiction:atlas-timeout-fix",
      "supersedes_key": "atlas-timeout-old"
    },
    {
      "key": "atlas-export-atomic",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "accepted",
      "title": "Atomic export publication",
      "body": "Write export content to a temporary file and rename it after flushing. Readers must never observe a half-written export.",
      "source_id": "fiction:atlas-export-atomic"
    },
    {
      "key": "atlas-export-verify",
      "repository": "Atlas",
      "kind": "lesson",
      "authority": "accepted",
      "title": "Verify export checksums",
      "body": "Compare SHA-256 checksums before and after moving an export. A successful copy command alone does not establish that all bytes arrived.",
      "source_id": "fiction:atlas-export-verify"
    },
    {
      "key": "atlas-auth",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "accepted",
      "title": "Refresh token rotation",
      "body": "Rotate refresh tokens after each use and revoke the token family when a consumed token is reused. Keep access tokens short lived.",
      "source_id": "fiction:atlas-auth"
    },
    {
      "key": "atlas-pagination",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "accepted",
      "title": "Stable activity pagination",
      "body": "Order activity pages by timestamp and record ID. Equal timestamps require a deterministic tie breaker so records are not skipped between pages.",
      "source_id": "fiction:atlas-pagination"
    },
    {
      "key": "atlas-logging",
      "repository": "Atlas",
      "kind": "lesson",
      "authority": "accepted",
      "title": "Credentials in request logs",
      "body": "Redact authorization headers and password fields before writing request logs. Log status codes and request IDs instead of credential values.",
      "source_id": "fiction:atlas-logging"
    },
    {
      "key": "atlas-accessibility",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "accepted",
      "title": "Keyboard navigation for dialogs",
      "body": "Every dialog must support keyboard focus, Escape to dismiss, and focus restoration to its opener. Visible focus rings must remain enabled.",
      "source_id": "fiction:atlas-accessibility"
    },
    {
      "key": "atlas-backup",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "accepted",
      "title": "Backup retention policy",
      "body": "Keep seven daily backups and four weekly backups. Verify restoration on a disposable directory before declaring a backup healthy.",
      "source_id": "fiction:atlas-backup"
    },
    {
      "key": "atlaslab-storage",
      "repository": "AtlasLab",
      "kind": "decision",
      "authority": "accepted",
      "title": "Embedded storage for desktop notes",
      "body": "Use SQLite for offline desktop notes in AtlasLab. Laboratory devices have their own retention rules and never share production records.",
      "source_id": "fiction:atlaslab-storage"
    },
    {
      "key": "lower-storage",
      "repository": "atlas",
      "kind": "decision",
      "authority": "accepted",
      "title": "Embedded storage for desktop notes",
      "body": "Use SQLite for offline desktop notes in lowercase atlas. This separate demonstration repository has no production ownership.",
      "source_id": "fiction:lower-storage"
    },
    {
      "key": "atlaslab-auth",
      "repository": "AtlasLab",
      "kind": "decision",
      "authority": "accepted",
      "title": "Refresh token rotation",
      "body": "Do not rotate refresh tokens in the disposable AtlasLab benchmark. This experimental exception is not approved for Atlas.",
      "source_id": "fiction:atlaslab-auth"
    },
    {
      "key": "lower-export",
      "repository": "atlas",
      "kind": "lesson",
      "authority": "accepted",
      "title": "Verify export checksums",
      "body": "The lowercase atlas tutorial verifies export checksums with SHA-256. Its files are examples, not Atlas release artifacts.",
      "source_id": "fiction:lower-export"
    },
    {
      "key": "atlas-search-proposal",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "proposed",
      "title": "Proposed semantic search",
      "body": "Evaluate multilingual embeddings for semantic search next quarter. No provider or deployment budget has been approved.",
      "source_id": "fiction:atlas-search-proposal"
    },
    {
      "key": "atlas-cache",
      "repository": "Atlas",
      "kind": "decision",
      "authority": "accepted",
      "title": "Bounded thumbnail cache",
      "body": "Keep the thumbnail cache below 128 entries and evict the least recently used item. This cache does not store authentication tokens.",
      "source_id": "fiction:atlas-cache"
    }
  ],
