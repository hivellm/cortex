{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hivellm.org/cortex/schemas/kinds/law_violation.schema.json",
  "title": "LawViolationPayload",
  "description": "Detector fired; emitted by governance engine (spec 14).",
  "type": "object",
  "required": ["violation_id", "law_id", "severity", "message"],
  "additionalProperties": false,
  "properties": {
    "violation_id": {
      "type": "string",
      "pattern": "^[0-9A-HJ-KM-NP-TV-Z]{26}$"
    },
    "law_id": {
      "type": "string",
      "pattern": "^[A-Z]+-[0-9]+$"
    },
    "law_version": {
      "type": ["integer", "null"],
      "minimum": 1
    },
    "severity": {
      "type": "string",
      "enum": ["info", "notable", "critical"]
    },
    "tier": {
      "type": ["integer", "null"],
      "minimum": 1,
      "maximum": 4
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2048
    },
    "evidence": {
      "type": "object",
      "additionalProperties": true
    },
    "observed_event_id": {
      "type": ["string", "null"],
      "pattern": "^[0-9A-HJ-KM-NP-TV-Z]{26}$"
    },
    "observed_event_kind": {
      "type": ["string", "null"],
      "enum": ["turn", "tool_call", null],
      "description": "Discriminator for observed_event_id. Required when observed_event_id is set so the cortex-graph writer can pick the right MERGE label without phantom-node risk."
    },
    "detector_latency_ms": {
      "type": ["integer", "null"],
      "minimum": 0
    }
  },
  "allOf": [
    {
      "if": {
        "required": ["observed_event_id"],
        "properties": {
          "observed_event_id": { "type": "string" }
        }
      },
      "then": {
        "required": ["observed_event_kind"],
        "properties": {
          "observed_event_kind": { "type": "string" }
        }
      }
    }
  ]
}
