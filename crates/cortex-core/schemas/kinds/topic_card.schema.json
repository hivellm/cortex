{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TopicCard payload (phase11r §1)",
  "description": "Living-synthesis topic card. The LLM rewrites synthesis_markdown whenever new evidence lands; contradictions surface explicitly; staleness signals (synthesis_age_d, events_since_last_rev) drive renderer downgrade.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topic_card_id",
    "topic_slug",
    "revision",
    "synthesis_markdown",
    "evidence",
    "confidence",
    "last_rev_at",
    "events_since_last_rev",
    "synthesis_model",
    "synthesis_cost_cents"
  ],
  "properties": {
    "topic_card_id": {
      "type": "string",
      "pattern": "^topic-[0-9a-f]{24}$",
      "description": "Deterministic id derived from (topic_slug, repo_scope) via derive_topic_card_id; SHA-256 prefix is stable across re-emits of the same card."
    },
    "topic_slug": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,78}[a-z0-9])?$",
      "description": "Kebab-case slug, 1..=80 chars, unique per repo scope."
    },
    "repos": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "default": []
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "Monotonic; increments on every rewrite that changes synthesis_markdown."
    },
    "synthesis_markdown": {
      "type": "string",
      "minLength": 200,
      "maxLength": 4000
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "id", "cited_at_rev"],
        "properties": {
          "kind": { "enum": ["consolidation", "decision", "law", "turn"] },
          "id": { "type": "string", "minLength": 1 },
          "weight": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
          },
          "cited_at_rev": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "contradictions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "evidence_a", "evidence_b", "surfaced_at_rev", "status"],
        "properties": {
          "kind": {
            "enum": [
              "decision_supersession",
              "law_violation_mismatch",
              "outcome_divergence"
            ]
          },
          "evidence_a": { "type": "string", "minLength": 1 },
          "evidence_b": { "type": "string", "minLength": 1 },
          "surfaced_at_rev": { "type": "integer", "minimum": 1 },
          "status": {
            "enum": ["open", "reconciled", "deprecated"]
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "default": [],
      "maxItems": 8,
      "items": { "type": "string", "minLength": 1, "maxLength": 200 }
    },
    "related_topic_ids": {
      "type": "array",
      "default": [],
      "maxItems": 32,
      "items": { "type": "string", "pattern": "^topic-[0-9a-f]{24}$" }
    },
    "confidence": {
      "type": "number",
      "minimum": 0.0,
      "maximum": 1.0
    },
    "last_rev_at": {
      "type": "string",
      "minLength": 1,
      "description": "RFC 3339 wall-clock timestamp of the last rewrite."
    },
    "events_since_last_rev": {
      "type": "integer",
      "minimum": 0
    },
    "synthesis_model": { "type": "string", "minLength": 1 },
    "synthesis_cost_cents": { "type": "integer", "minimum": 0 }
  }
}
