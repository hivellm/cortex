{
  "searchableAttributes": ["title", "body", "category", "tags"],
  "filterableAttributes": ["category", "repo", "tags", "occurred_at"],
  "sortableAttributes": ["occurred_at"],
  "displayedAttributes": ["*"],
  "rankingRules": ["words", "typo", "proximity", "attribute", "sort", "exactness", "occurred_at:desc"],
  "stopWords": ["a", "an", "the", "of", "in", "to", "and", "or"],
  "synonyms": {
    "pattern": ["best practice", "convention"],
    "anti-pattern": ["smell", "anti pattern"]
  },
  "typoTolerance": {
    "enabled": true,
    "minWordSizeForTypos": { "oneTypo": 4, "twoTypos": 8 }
  }
}
